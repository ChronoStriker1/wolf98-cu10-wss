@ECHO OFF
ECHO Wolfenstein 3D PC-9821 Cu10 WSS and FM sound patch R2
IF NOT EXIST B:\WOLF3D\WOLF98.EXE GOTO NOGAME
ECHO Building VSWAP.WL6 from the installed disk pieces...
IF NOT EXIST B:\WOLF3D\VSWAP.00 GOTO CHECKVSWAP
IF NOT EXIST B:\WOLF3D\VSWAP.01 GOTO NODATA
IF EXIST B:\WOLF3D\VSWAP.WL6 DEL B:\WOLF3D\VSWAP.WL6
COPY /B B:\WOLF3D\VSWAP.00+B:\WOLF3D\VSWAP.01 B:\WOLF3D\VSWAP.WL6
IF ERRORLEVEL 1 GOTO FAILED
DEL B:\WOLF3D\VSWAP.00
DEL B:\WOLF3D\VSWAP.01
:CHECKVSWAP
IF NOT EXIST B:\WOLF3D\VSWAP.WL6 GOTO NODATA
ECHO Building 98GRAPH.WL6 from the installed disk pieces...
IF NOT EXIST B:\WOLF3D\98GRA.00 GOTO CHECKGRAPH
IF NOT EXIST B:\WOLF3D\98GRA.01 GOTO NODATA
IF EXIST B:\WOLF3D\98GRAPH.WL6 DEL B:\WOLF3D\98GRAPH.WL6
COPY /B B:\WOLF3D\98GRA.00+B:\WOLF3D\98GRA.01 B:\WOLF3D\98GRAPH.WL6
IF ERRORLEVEL 1 GOTO FAILED
DEL B:\WOLF3D\98GRA.00
DEL B:\WOLF3D\98GRA.01
:CHECKGRAPH
IF NOT EXIST B:\WOLF3D\98GRAPH.WL6 GOTO NODATA
ECHO Restoring the original PC-98 audio archive...
IF NOT EXIST C:\AUDIOHED.WL6 GOTO NOAUDIO
IF NOT EXIST C:\AUDIOT.WL6 GOTO NOAUDIO
IF EXIST B:\WOLF3D\AUDIOHED.NEW DEL B:\WOLF3D\AUDIOHED.NEW
IF EXIST B:\WOLF3D\AUDIOT.NEW DEL B:\WOLF3D\AUDIOT.NEW
IF EXIST B:\WOLF3D\AUDIOHED.WL6 DEL B:\WOLF3D\AUDIOHED.WL6
IF EXIST B:\WOLF3D\AUDIOHED.WL6 GOTO AUDIODELETE
COPY /B C:\AUDIOHED.WL6 B:\WOLF3D\AUDIOHED.WL6
IF ERRORLEVEL 1 GOTO AUDIOCOPY
IF NOT EXIST B:\WOLF3D\AUDIOHED.WL6 GOTO AUDIOCOPY
IF EXIST B:\WOLF3D\AUDIOT.WL6 DEL B:\WOLF3D\AUDIOT.WL6
IF EXIST B:\WOLF3D\AUDIOT.WL6 GOTO AUDIODELETE
COPY /B C:\AUDIOT.WL6 B:\WOLF3D\AUDIOT.WL6
IF ERRORLEVEL 1 GOTO AUDIOCOPY
IF NOT EXIST B:\WOLF3D\AUDIOT.WL6 GOTO AUDIOCOPY
ECHO Installing the Cu10 WSS and YMF701 OPL3 executable...
IF NOT EXIST C:\WOLF98.EXE GOTO NOPATCH
DEL B:\WOLF3D\WOLF98.EXE
IF EXIST B:\WOLF3D\WOLF98.EXE GOTO OLDDELETE
COPY /B C:\WOLF98.EXE B:\WOLF3D\WOLF98.EXE
IF NOT EXIST B:\WOLF3D\WOLF98.EXE GOTO COPYFAILED
IF EXIST B:\WOLF3D\WOLF98.ORG DEL B:\WOLF3D\WOLF98.ORG
ECHO.
ECHO CU10-R2 patch installed. Remove this disk, then run:
ECHO B:
ECHO CD \WOLF3D
ECHO WOLF98
GOTO END
:NOGAME
ECHO ERROR: B:\WOLF3D\WOLF98.EXE was not found.
GOTO END
:NODATA
ECHO ERROR: One of the installed .00 or .01 data pieces is missing.
ECHO Reinstall the four base disks, then run this patch again.
GOTO END
:NOPATCH
ECHO ERROR: C:\WOLF98.EXE is missing from the patch disk.
GOTO END
:NOAUDIO
ECHO ERROR: The PC-98 audio files are missing from the patch disk.
GOTO END
:AUDIOCOPY
ECHO ERROR: A PC-98 audio file could not be copied to B:.
GOTO END
:AUDIODELETE
ECHO ERROR: An old PC-98 audio file could not be deleted from B:.
GOTO END
:OLDDELETE
ECHO ERROR: The old B:\WOLF3D\WOLF98.EXE could not be deleted.
GOTO END
:COPYFAILED
ECHO ERROR: WOLF98.EXE could not be copied from C: to B:\WOLF3D.
GOTO END
:FAILED
ECHO ERROR: A game data build failed.
:END
